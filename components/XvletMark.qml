import QtQuick
import QtQuick.Shapes

// xvlet's mark (generated by tools/mark.py, as assets/brand/xvlet.svg): an
// x of two arcs back to back, ")(". One colour (ink). It moves: spread
// draws the arcs apart (0: as drawn), turn turns the whole.
Item {
    id: root
    property color ink: "#1b1d24"
    property real spread: 0             // px of the 512 box, each arc outwards
    property real turn: 0               // degrees
    implicitWidth: 64
    implicitHeight: 64

    Item {
        width: 512; height: 512
        transform: [
            Rotation { origin.x: 256.0; origin.y: 256.0; angle: root.turn },
            Scale { xScale: root.width / 512; yScale: root.height / 512 }
        ]
        Shape {
            width: 512; height: 512
            preferredRendererType: Shape.CurveRenderer
            transform: Translate { x: -root.spread }
            ShapePath { strokeWidth: 66; strokeColor: root.ink; fillColor: "transparent"; capStyle: ShapePath.RoundCap; PathSvg { path: "M119.0 82.8 A200 200 0 0 1 119.0 429.2" } }
        }
        Shape {
            width: 512; height: 512
            preferredRendererType: Shape.CurveRenderer
            transform: Translate { x: root.spread }
            ShapePath { strokeWidth: 66; strokeColor: root.ink; fillColor: "transparent"; capStyle: ShapePath.RoundCap; PathSvg { path: "M393.0 429.2 A200 200 0 0 1 393.0 82.8" } }
        }
    }
}
