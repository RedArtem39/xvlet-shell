import QtQuick
import QtQuick.Shapes

// xvlet's mark (generated by tools/mark.py, as assets/brand/xvlet.svg):
// wings of shards in three tones. Every shard moves on its own: scatter
// (0 whole, 1 flown apart and turned), flap (degrees: the wings beat
// about the body).
Item {
    id: root
    property color ink: "#1b1d24"
    property color ink2: Qt.tint(ink, "#40ffffff")
    property color ink3: Qt.tint(ink, "#80ffffff")
    property real scatter: 0
    property real flap: 0
    implicitWidth: 64
    implicitHeight: 64

    component Shard: Shape {
        id: sh
        property string d
        property int tone
        property real cx
        property real cy
        property real fx
        property real fy
        property real spin
        property int wing              // 1 the right wing, -1 the left, 0 the body
        width: 512; height: 512
        preferredRendererType: Shape.CurveRenderer
        transform: [
            // the wing beats about the body's top
            Rotation { origin.x: 256.0; origin.y: 308.0; angle: -root.flap * wing },
            Rotation { origin.x: cx; origin.y: cy; angle: spin * root.scatter },
            Translate { x: fx * root.scatter; y: fy * root.scatter }
        ]
        opacity: 1 - root.scatter * .35
        ShapePath { strokeWidth: -1; fillColor: tone === 0 ? root.ink : tone === 1 ? root.ink2 : root.ink3; PathSvg { path: sh.d } }
    }

    Item {
        // the drawing's box: 340 square round the middle
        width: 340; height: 340
        transform: [ Translate { x: -86.0; y: -106.0 }, Scale { xScale: root.width / 340; yScale: root.height / 340 } ]
        Shard { d: "M260.0 312.0 L318.0 284.0 L406.0 136.0 Z"; tone: 1; cx: 328.0; cy: 244.0; fx: 46.5; fy: -55.3; spin: -45; wing: 1 }
        Shard { d: "M260.0 312.0 L406.0 136.0 L286.0 256.0 Z"; tone: 0; cx: 317.3; cy: 234.7; fx: 53.7; fy: -46.9; spin: 2; wing: 1 }
        Shard { d: "M286.0 256.0 L406.0 136.0 L352.0 226.0 Z"; tone: 0; cx: 348.0; cy: 206.0; fx: 66.8; fy: -65.9; spin: -41; wing: 1 }
        Shard { d: "M282.0 316.0 L374.0 268.0 L382.0 276.0 L300.0 334.0 Z"; tone: 1; cx: 334.5; cy: 298.5; fx: 55.1; fy: 9.0; spin: 6; wing: 1 }
        Shard { d: "M374.0 268.0 L406.0 288.0 L382.0 276.0 Z"; tone: 2; cx: 387.3; cy: 277.3; fx: 69.8; fy: -24.6; spin: -37; wing: 1 }
        Shard { d: "M256.0 308.0 L310.0 298.0 L256.0 368.0 Z"; tone: 0; cx: 274.0; cy: 324.7; fx: 43.5; fy: 61.5; spin: 10; wing: 0 }
        Shard { d: "M256.0 368.0 L310.0 298.0 L286.0 334.0 Z"; tone: 2; cx: 284.0; cy: 333.3; fx: 21.6; fy: 40.2; spin: -33; wing: 0 }
        Shard { d: "M252.0 312.0 L194.0 284.0 L106.0 136.0 Z"; tone: 1; cx: 184.0; cy: 244.0; fx: -60.5; fy: -37.3; spin: 14; wing: -1 }
        Shard { d: "M252.0 312.0 L106.0 136.0 L226.0 256.0 Z"; tone: 0; cx: 194.7; cy: 234.7; fx: -39.7; fy: -64.9; spin: -29; wing: -1 }
        Shard { d: "M226.0 256.0 L106.0 136.0 L160.0 226.0 Z"; tone: 0; cx: 164.0; cy: 206.0; fx: -66.8; fy: -47.9; spin: 18; wing: -1 }
        Shard { d: "M230.0 316.0 L138.0 268.0 L130.0 276.0 L212.0 334.0 Z"; tone: 1; cx: 177.5; cy: 298.5; fx: -69.1; fy: -9.0; spin: -25; wing: -1 }
        Shard { d: "M138.0 268.0 L106.0 288.0 L130.0 276.0 Z"; tone: 2; cx: 124.7; cy: 277.3; fx: -55.8; fy: -6.6; spin: 22; wing: -1 }
        Shard { d: "M256.0 308.0 L202.0 298.0 L256.0 368.0 Z"; tone: 0; cx: 238.0; cy: 324.7; fx: -43.5; fy: 43.5; spin: -21; wing: 0 }
        Shard { d: "M256.0 368.0 L202.0 298.0 L226.0 334.0 Z"; tone: 2; cx: 228.0; cy: 333.3; fx: -35.6; fy: 58.2; spin: 26; wing: 0 }
    }
}
